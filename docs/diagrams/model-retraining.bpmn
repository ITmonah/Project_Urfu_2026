<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_model_retraining" targetNamespace="https://example.org/kgo/documentation" exporter="KGO documentation">
  <bpmn:process id="Process_KGO" name="Переобучение: новые данные, контроль качества, выпуск" isExecutable="false">
    <bpmn:documentation>Предлагаемый процесс. Пороги согласуются заранее; при отказе сохраняется или восстанавливается прежняя версия.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_KGO">
      <bpmn:lane id="Lane_0" name="ML / MLOps">
        <bpmn:flowNodeRef>Schedule</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Signal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Load</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Prepare</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Train</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Evaluate</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_1" name="Эксперт / разметчик">
        <bpmn:flowNodeRef>Label</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Validate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Quality</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_2" name="Эксплуатация">
        <bpmn:flowNodeRef>Register</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Deploy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Smoke</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Health</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Rollback</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Log</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Monitor</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Schedule" name="По расписанию">
      <bpmn:documentation>Предлагаемый этап; автоматизация в репозитории не реализована.</bpmn:documentation>
      <bpmn:outgoing>Flow_0</bpmn:outgoing>
      <bpmn:timerEventDefinition id="EventDefinition_Schedule" />
    </bpmn:startEvent>
    <bpmn:startEvent id="Signal" name="Сигнал мониторинга">
      <bpmn:documentation>Предлагаемый этап; автоматизация в репозитории не реализована.</bpmn:documentation>
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
      <bpmn:conditionalEventDefinition id="EventDefinition_Signal">
        <bpmn:condition>Наступило условие пересмотра модели по мониторингу качества</bpmn:condition>
      </bpmn:conditionalEventDefinition>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="Merge" name="">
      <bpmn:documentation>Предлагаемый этап; автоматизация в репозитории не реализована.</bpmn:documentation>
      <bpmn:incoming>Flow_0</bpmn:incoming>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Load" name="Загрузить новые фото и обратную связь">
      <bpmn:documentation>Предлагаемый этап; автоматизация в репозитории не реализована.</bpmn:documentation>
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Prepare" name="Версионировать данные и разделить train / val / test">
      <bpmn:documentation>Предлагаемый этап; автоматизация в репозитории не реализована.</bpmn:documentation>
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Train" name="Обучить нужные компоненты">
      <bpmn:documentation>Предлагаемый этап; автоматизация в репозитории не реализована.</bpmn:documentation>
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Evaluate" name="Оценить кандидата и весь пайплайн">
      <bpmn:documentation>Предлагаемый этап; автоматизация в репозитории не реализована.</bpmn:documentation>
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Label" name="Проверить фото и разметить данные">
      <bpmn:documentation>Предлагаемый этап; автоматизация в репозитории не реализована.</bpmn:documentation>
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Validate" name="Проверить метрики, ошибки и срезы">
      <bpmn:documentation>Предлагаемый этап; автоматизация в репозитории не реализована.</bpmn:documentation>
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Quality" name="Критерии качества выполнены?">
      <bpmn:documentation>Предлагаемый этап; автоматизация в репозитории не реализована.</bpmn:documentation>
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Register" name="Выпустить веса и обновить model card">
      <bpmn:documentation>Предлагаемый этап; автоматизация в репозитории не реализована.</bpmn:documentation>
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Deploy" name="Подключить версию и перезапустить сервис">
      <bpmn:documentation>Предлагаемый этап; автоматизация в репозитории не реализована.</bpmn:documentation>
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Smoke" name="Проверить сервис после выпуска">
      <bpmn:documentation>Предлагаемый этап; автоматизация в репозитории не реализована.</bpmn:documentation>
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Health" name="Проверка успешна?">
      <bpmn:documentation>Предлагаемый этап; автоматизация в репозитории не реализована.</bpmn:documentation>
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Rollback" name="Откатить на прежнюю версию">
      <bpmn:documentation>Предлагаемый этап; автоматизация в репозитории не реализована.</bpmn:documentation>
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Log" name="Сохранить причину, уведомить ML-команду">
      <bpmn:documentation>Предлагаемый этап; автоматизация в репозитории не реализована.</bpmn:documentation>
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Monitor" name="Продолжить мониторинг действующей версии">
      <bpmn:documentation>Предлагаемый этап; автоматизация в репозитории не реализована.</bpmn:documentation>
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:incoming>Flow_17</bpmn:incoming>
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End" name="Цикл завершён">
      <bpmn:documentation>Предлагаемый этап; автоматизация в репозитории не реализована.</bpmn:documentation>
      <bpmn:incoming>Flow_18</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_0" sourceRef="Schedule" targetRef="Merge" name="" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Signal" targetRef="Merge" name="" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Merge" targetRef="Load" name="" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Load" targetRef="Label" name="" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Label" targetRef="Prepare" name="" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Prepare" targetRef="Train" name="" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Train" targetRef="Evaluate" name="" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Evaluate" targetRef="Validate" name="" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Validate" targetRef="Quality" name="" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Quality" targetRef="Register" name="Да">
      <bpmn:conditionExpression>критерии качества выполнены</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Quality" targetRef="Log" name="Нет">
      <bpmn:conditionExpression>критерии качества не выполнены</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Register" targetRef="Deploy" name="" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Deploy" targetRef="Smoke" name="" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Smoke" targetRef="Health" name="" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Health" targetRef="Rollback" name="Нет">
      <bpmn:conditionExpression>проверка сервиса не пройдена</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Rollback" targetRef="Log" name="" />
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Health" targetRef="Monitor" name="Да">
      <bpmn:conditionExpression>проверка сервиса пройдена</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_17" sourceRef="Log" targetRef="Monitor" name="" />
    <bpmn:sequenceFlow id="Flow_18" sourceRef="Monitor" targetRef="End" name="" />
  </bpmn:process>
  <bpmn:collaboration id="Collaboration_KGO">
    <bpmn:participant id="Participant_KGO" name="Процесс КГО" processRef="Process_KGO" />
  </bpmn:collaboration>
